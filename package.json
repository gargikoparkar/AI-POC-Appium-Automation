{
    "name": "appium-android-framework",
    "version": "1.0.0",
    "license": "MIT",
    "description": "Pure Appium (UiAutomator2) Android test framework in TypeScript + Mocha, with Appium MCP for live inspection",
    "private": true,
    "engines": {
        "node": ">=20.19.0"
    },
    "keywords": [
        "appium",
        "android",
        "uiautomator2",
        "mocha",
        "mcp"
    ],
    "type": "module",
    "scripts": {
        "appium": "appium --relaxed-security --log ./logs/appium.log --log-level warn",
        "appium:inspector": "npx start-appium-inspector",
        "test": "mocha \"tests/specs/**/*.spec.ts\"",
        "test:spec": "mocha",
        "lint": "eslint src tests",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/chai": "^5.2.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "@typescript-eslint/parser": "^8.50.1",
        "appium": "^3.1.2",
        "appium-inspector-plugin": "^2026.9.2",
        "appium-uiautomator2-driver": "^9.0.1",
        "chai": "^6.3.0",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "tsx": "^4.20.3",
        "typescript": "^7.0.2",
        "webdriverio": "^10.0.2"
    }
}
