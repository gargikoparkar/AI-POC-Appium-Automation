{
    "compilerOptions": {
        "sourceMap": false,
        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "removeComments": true,
        "noImplicitAny": true,
        "strictPropertyInitialization": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node",
            "mocha"
        ]
    },
    "include": [
        "./src/**/*.ts",
        "./tests/**/*.ts"
    ]
}
